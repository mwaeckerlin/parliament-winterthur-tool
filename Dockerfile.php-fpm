# syntax=docker/dockerfile:1.4
#
# parlwin PHP-FPM image: erweitert mwaeckerlin/nextcloud:php-fpm und legt
# die kompilierte App ins Seed-Verzeichnis.  Die Basis-Bootstrap kopiert das
# Seed beim ersten Start ins `apps`-Volume (`seedCustomAppsIfEmpty()`), der
# eigene Bootstrap-Wrapper aktiviert die App danach via `occ app:enable`.
#
# Es gibt absichtlich keine `target:`-Splits mehr — Docker Hub Auto-Builds
# bauen immer die finale Stage, also genau dieses Image.

# PHP-Composer-Abhängigkeiten (z.B. smalot/pdfparser für den Budget-Import).
# very-base ist Alpine mit Shell und Paketmanager; Composer kommt als Paket.
# --ignore-platform-reqs: die PHP-Erweiterungen sind erst im Runtime-Image
# (nextcloud:php-fpm) vorhanden, hier wird nur heruntergeladen.
FROM mwaeckerlin/very-base AS composer
WORKDIR /deps
RUN ${PKG_INSTALL} composer
COPY parlwin/composer.json ./composer.json

# `npm run composer:update -- --lock` löst composer.json neu auf und holt die
# Stufe `composer-lock` heraus (tests/vendor-aktualisieren.sh).
FROM composer AS composer-lock-bau
RUN composer update --no-install --no-interaction --no-progress --ignore-platform-reqs

FROM scratch AS composer-lock
COPY --from=composer-lock-bau /deps/composer.lock /composer.lock

# Der Bau installiert genau die Fassungen aus parlwin/composer.lock.
FROM composer AS php-deps
COPY parlwin/composer.lock ./composer.lock
RUN composer install --no-dev --no-interaction --no-progress --prefer-dist --ignore-platform-reqs

# Prüft die ausgelieferten Fassungen aus composer.lock auf gemeldete Lücken und
# bricht bei einem Treffer ab.
FROM php-deps AS php-audit
RUN composer audit --locked --no-dev --no-interaction

# Dieselben Abhängigkeiten samt Entwicklungswerkzeugen (PHPUnit), für den
# Testlauf auf dem Rechner und auf dem GitHub-Runner: beide haben kein PHPUnit
# im Pfad, und `parlwin/vendor` ist git-ignoriert. `npm run composer:update`
# holt die Stufe `php-vendor` heraus (tests/vendor-aktualisieren.sh). Das
# ausgelieferte Image bleibt ohne Testwerkzeug, es kopiert aus `php-deps`.
FROM php-deps AS php-deps-test
RUN composer install --no-interaction --no-progress --prefer-dist --ignore-platform-reqs

FROM scratch AS php-vendor
COPY --from=php-deps-test /deps/vendor /vendor

# GNU libiconv als LD_PRELOAD-fähige Bibliothek, weil musls iconv viele
# PDF-Font-Kodierungen nicht kennt. Warum und wie: docker/iconv-shim.c, der
# auch im Image des Testlaufs gebaut wird (Dockerfile.php-test).
FROM mwaeckerlin/very-base AS iconv
RUN ${PKG_INSTALL} gnu-libiconv gnu-libiconv-dev build-base
COPY docker/iconv-shim.c /shim.c
RUN gcc -shared -fPIC -O2 -o /preloadable_libiconv.so /shim.c -liconv

# `npm run lock:aktualisieren` löst die Abhängigkeiten mit dem npm dieser Basis
# neu auf und holt die Stufe `npm-lock` heraus (tests/lock-aktualisieren.sh):
# npm 9 bricht beim Auflösen dieses Baums mit den `overrides` ab.
FROM mwaeckerlin/nodejs-build AS npm-lock-bau
WORKDIR /build
COPY --chown=${BUILD_USER} package*.json ./
RUN npm --version > npm-version
RUN npm install --package-lock-only --no-audit --no-fund

FROM scratch AS npm-lock
COPY --from=npm-lock-bau /build/package-lock.json /package-lock.json
COPY --from=npm-lock-bau /build/npm-version /npm-version

FROM mwaeckerlin/nodejs-build AS app-build
WORKDIR /build
COPY --chown=${BUILD_USER} package*.json ./
RUN npm install --no-audit --no-fund

COPY --chown=${BUILD_USER} parlwin/ ./parlwin/
# CHANGELOG.md und README.md werden zur Build-Zeit eingebunden: der «Änderungs-
# verlauf» aus @changelog → ../CHANGELOG.md, die «Bedienungsanleitung» aus
# @readme → ../README.md (relativ zu parlwin/). Fehlt eine der Dateien, scheitert
# der Webpack-Build im Image.
COPY --chown=${BUILD_USER} CHANGELOG.md ./CHANGELOG.md
COPY --chown=${BUILD_USER} README.md ./README.md
# Ein parlwin/vendor aus dem Arbeitsverzeichnis trägt die Werkzeuge der
# Entwicklung; das Image bekommt vendor allein aus der Stufe php-deps.
RUN npm run build:app \
    && rm -rf node_modules \
    parlwin/vendor \
    parlwin/src \
    parlwin/tests \
    parlwin/phpunit.xml \
    parlwin/.phpunit.result.cache

FROM mwaeckerlin/nextcloud:php-fpm-nc33
# GNU libiconv vorladen, damit PHPs iconv() alle PDF-Font-Kodierungen abdeckt
# (MacRoman u.a.) — sonst extrahiert smalot aus manchen Budgetbüchern leeren Text
# (siehe iconv-Stage oben). Die Bibliothek ist eigenständig LD_PRELOAD-tauglich.
COPY --from=iconv /preloadable_libiconv.so /usr/lib/preloadable_libiconv.so
COPY --from=iconv /usr/lib/libiconv.so.2 /usr/lib/libiconv.so.2
COPY --from=iconv /usr/lib/libcharset.so.1 /usr/lib/libcharset.so.1
ENV LD_PRELOAD=/usr/lib/preloadable_libiconv.so
# Zusaetzliches Verzeichnis fuer php.ini-Einstellungen: Der fuehrende Doppelpunkt
# haelt den eingebauten Standard (/etc/php*/conf.d) in der Liste, der Bootstrap
# schreibt dort die Speichergrenze hinein (parlwin-bootstrap.php).  Ein fester
# Pfad nach /etc/php85 wuerde die PHP-Version des Basis-Images festschreiben.
ENV PHP_INI_SCAN_DIR=":/tmp/parlwin-php.d"
COPY --from=app-build /build/parlwin /usr/local/share/nextcloud/seed/custom_apps/parlwin
# Composer-vendor (smalot/pdfparser) — von Application.php via vendor/autoload.php geladen.
COPY --from=php-deps /deps/vendor /usr/local/share/nextcloud/seed/custom_apps/parlwin/vendor
# Bootstrap-Wrapper in PHP, weil die Basis keine Shell hat.
COPY --chmod=644 docker/parlwin-bootstrap.php /usr/local/bin/parlwin-bootstrap.php
COPY --chmod=644 docker/parlwin-watcher.php   /usr/local/bin/parlwin-watcher.php
ENTRYPOINT ["/usr/bin/php", "/usr/local/bin/parlwin-bootstrap.php"]
