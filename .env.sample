NEXTCLOUD_DB_PASSWORD=change_me_db_password
NEXTCLOUD_ADMIN_PASSWORD=change_me_admin_password

# Optional:
# COMPOSE_PROJECT_NAME=parlwin_dev
# NEXTCLOUD_HTTP_PORT=29824
# Adresse des Rechners, auf der der Port erscheint; leer heisst alle Adressen, IPv4 und IPv6. 127.0.0.1 lässt nur den Rechner selbst zu, 0.0.0.0 öffnet alle IPv4-Adressen und keine IPv6-Adresse.
# BIND_ADDRESS=127.0.0.1
# HOST=localhost:29824
# PROTOCOL=http
# WEBROOT=
# Ohne Wert leitet die Oberfläche die Adresse aus der Herkunft der Seite ab, ws(s)://<host>[<WEBROOT>]/ws/parlwin/. Ein Wert ist nur nötig, wenn Nextcloud unter einer anderen öffentlichen Adresse als HOST erreichbar ist, etwa hinter einem fremden CDN.
# PARLWIN_REALTIME_WS_URL=wss://cloud.example.com/ws/parlwin/
# PARLWIN_REALTIME_PUBLISH_URL=http://parlwin-realtime:3001/publish
# PARLWIN_REALTIME_SECRET=change_me_realtime_secret
# PARLWIN_REALTIME_AUTH_REQUIRED=1
# PARLWIN_NEXTCLOUD_BASE_URL=http://nextcloud-nginx:8080
# PARLWIN_NEXTCLOUD_AUTH_URL=
# Speichergrenze von PHP auf der Kommandozeile im Container: occ, Hintergrundauftrag und Synchronisation.
# PARLWIN_PHP_MEMORY_LIMIT=1024M
# Adresse der Parlamentswebseite; leer heisst https://parlament.winterthur.ch. Der E2E-Lauf zeigt damit auf die lokale Quelle parlwin-quelle.
# PARLWIN_QUELLE_BASE_URL=
# Adresse der Webseite der Stadt für die Stadtratsbeschlüsse; leer heisst https://stadt.winterthur.ch. Der E2E-Lauf zeigt damit auf die lokale Quelle parlwin-quelle.
# PARLWIN_STADT_BASE_URL=
# Wie viele Listenseiten der Stadtratsbeschlüsse die Synchronisation liest, je zwölf Beschlüsse; 0 heisst alle Seiten.
# PARLWIN_SRB_SEITEN=10
# Grenzen der Synchronisation je Bereich, leer heisst ohne Grenze; README, Abschnitt «Automatischer E2E-Test».
# PARLWIN_SYNC_LIMIT_ALL=
# PARLWIN_SYNC_LIMIT_GESCHAEFTE=
# PARLWIN_SYNC_LIMIT_SITZUNGEN=
# PARLWIN_SYNC_LIMIT_MITGLIEDER=
# PARLWIN_SYNC_LIMIT_KOMMISSIONEN=
# PARLWIN_SYNC_LIMIT_FRAKTIONEN=
# Zeitgrenzen jedes Abrufs einer Webseite durch die Synchronisation, in Sekunden, und die kleinste Rate in Byte je Sekunde; README, Abschnitt «Lokale Docker-Umgebung (mwaeckerlin/nextcloud und Plugin)». docker-compose.yml reicht sie nicht an den Container weiter, sie wirken erst unter `environment` des Dienstes `nextcloud-php-fpm`.
# PARLWIN_SYNC_HTTP_CONNECT_TIMEOUT=8
# PARLWIN_SYNC_HTTP_TIMEOUT=25
# PARLWIN_SYNC_HTTP_LOW_SPEED_TIME=12
# PARLWIN_SYNC_HTTP_LOW_SPEED_LIMIT=1
# Die übrigen Variablen der Synchronisation und der Dokumente reicht docker-compose.yml nicht an den Container weiter; README, Abschnitt «Lokale Docker-Umgebung (mwaeckerlin/nextcloud und Plugin)», nennt sie und sagt, wo sie einzutragen sind.
